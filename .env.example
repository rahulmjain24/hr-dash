# Copy to .env and fill in the values: cp .env.example .env

# ---- Backend ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ---- Database (also used by docker-compose to create Postgres) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=hr_user
DB_PASSWORD=change_me
DB_NAME=hr_database

# ---- Auth ----
# Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change_me
AUTH_COOKIE_NAME=access_token

# ---- File storage (MinIO) ----
MINIO_ROOT_USER=minioadmin
# Must be at least 8 characters
MINIO_ROOT_PASSWORD=change_me_please
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Created automatically on backend startup if missing
MINIO_BUCKET=hr-documents
# Files uploaded before the application is submitted; expired after 1 day
MINIO_TMP_BUCKET=hr-documents-tmp

# ---- Email (optional; needed for password reset emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HR Portal <no-reply@localhost>

# ---- Frontend (Next.js reads these from apps/frontend-hr/.env.local, not this file) ----
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_AUTH_COOKIE_NAME=access_token
